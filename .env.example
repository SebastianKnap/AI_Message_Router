# Skopiuj do .env: cp .env.example .env
# Wszystkie wartosci maja sensowne domyslne ustawienia w docker-compose.yml,
# ten plik sluzy do nadpisywania ich lokalnie.

# --- Model ---
# Model musi wspierac tool calling. Wybrany pomiarem w E1.5 (spike): llama3.2:3b,
# 6/6 trafnosci, mediana 10,6s. qwen3:4b odrzucony - ignoruje think:false na Ollama
# 0.32.3 (znany bug), odpowiedz >200s. Patrz eval/spike_tool_calling.py.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
# Ile sekund czekamy na odpowiedz modelu. Na wolnym CPU pierwszy request trwa dluzej.
LLM_TIMEOUT_SECONDS=120
# Jak dlugo model zostaje w pamieci po ostatnim uzyciu. Wartosc ujemna = bezterminowo.
# Domyslne 5 minut Ollamy sprawiloby, ze rozgrzanie modelu traci sens.
OLLAMA_KEEP_ALIVE=-1

# --- Poczta ---
SMTP_HOST=mailpit
SMTP_PORT=1025
# Adres, z ktorego wychodzi mail. Odpowiedzi i tak ida na Reply-To nadawcy.
MAIL_FROM=router@example.com

# --- Aplikacja ---
LOG_LEVEL=INFO
